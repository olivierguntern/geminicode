{
  "name": "gemini-code",
  "version": "0.1.0",
  "description": "A Gemini-powered CLI coding assistant, inspired by Claude Code",
  "bin": {
    "gemini-code": "bin/gemini-code"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "gemini",
    "ai",
    "cli",
    "coding",
    "assistant"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "chalk": "^5.3.0",
    "diff": "^7.0.0",
    "minimist": "^1.2.8",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
